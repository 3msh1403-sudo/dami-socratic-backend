# Two independent Google AI Studio projects. Keep both keys server-side.
SCOPE_GEMINI_API_KEY=YOUR_FIRST_PROJECT_API_KEY
CHAT_GEMINI_API_KEY=YOUR_SECOND_PROJECT_API_KEY

# Set each to a model actually available to the corresponding project.
SCOPE_MODEL_NAME=YOUR_SCOPE_MODEL
GEMINI_MODEL_NAME=YOUR_CHAT_MODEL

# Optional dedicated embedding key. If blank, chat key then scope key are tried.
# Embedding model and dimension are intentionally unchanged.
EMBEDDING_GEMINI_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_RPC_NAME=match_dami_documents

TEXTBOOK_TOP_K=4
QA_TOP_K=3
MATCH_THRESHOLD=0.0
TEXTBOOK_FILTER_METADATA={}
QA_FILTER_METADATA={"type":"qa_example"}
QA_RETRIEVAL_ENABLED=false

MAX_QUESTION_LENGTH=4000
REQUEST_TIMEOUT=45
CORS_ORIGINS=*
