# Google Gemini API key (server-side only)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Use a Gemini model available to your API key
GEMINI_MODEL_NAME=gemini-2.5-flash
SCOPE_MODEL_NAME=gemini-2.5-flash

# Existing Dami embedding setup: Gemini Embedding, 768 dimensions
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Supabase project URL and SERVICE ROLE key (never put these in frontend code)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_RPC_NAME=match_dami_documents

# Retrieval
TEXTBOOK_TOP_K=4
QA_TOP_K=3
MATCH_THRESHOLD=0.0

# Amas has two retrieval lanes. Textbook filter is empty by default so
# current Dami chunks are not accidentally excluded. Enable QA filtering
# only if QA examples are actually stored in Supabase with this metadata.
TEXTBOOK_FILTER_METADATA={}
QA_FILTER_METADATA={"type":"qa_example"}
QA_RETRIEVAL_ENABLED=false

MAX_QUESTION_LENGTH=4000
REQUEST_TIMEOUT=45

# Restrict this to your frontend origin(s) in production.
# Multiple origins: https://example.com,https://www.example.com
CORS_ORIGINS=*
